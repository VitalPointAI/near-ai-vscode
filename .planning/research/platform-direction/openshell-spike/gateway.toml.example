[openshell]
version = 2

[openshell.gateway]
name           = "nearai-spike"
bind_address   = "127.0.0.1:27670"
log_level      = "info"
compute_driver = "podman"
policy_validation_failure_mode = "fail_closed"
guest_tls_ca   = "$SPIKE/pki/ca.crt"

[openshell.gateway.tls]
cert_path      = "$SPIKE/pki/server/tls.crt"
key_path       = "$SPIKE/pki/server/tls.key"
client_ca_path = "$SPIKE/pki/ca.crt"

[openshell.gateway.gateway_jwt]
signing_key_path = "$SPIKE/pki/jwt/signing.pem"
public_key_path  = "$SPIKE/pki/jwt/public.pem"
kid_path         = "$SPIKE/pki/jwt/kid"
gateway_id       = "nearai-spike"

[openshell.drivers.podman]
network_name      = "nearai-openshell-spike"
socket_path       = "$XDG_RUNTIME_DIR/nearai-os-spike/podman.sock"
default_image     = "localhost/nearai-openshell-spike:1"
image_pull_policy = "if_not_present"
grpc_endpoint     = "https://127.0.0.1:27670"
enable_bind_mounts = false
