export SP=$SPIKE
export PATH=$SPIKE/bin:$PATH
export XDG_CONFIG_HOME=$SPIKE/xdg/config XDG_STATE_HOME=$SPIKE/xdg/state XDG_DATA_HOME=$SPIKE/xdg/data XDG_CACHE_HOME=$SPIKE/xdg/cache
export OPENSHELL_TELEMETRY_ENABLED=false
export OPENSHELL_TELEMETRY_ENDPOINT=http://127.0.0.1:9/disabled
export OPENSHELL_GATEWAY_CONFIG=$SPIKE/gateway.toml
export OPENSHELL_DB_URL=sqlite://$SPIKE/xdg/state/openshell.db
