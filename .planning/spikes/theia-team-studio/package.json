{
  "name": "near-ai-theia-preview",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "extension"
  ],
  "dependencies": {
    "@near-ai/theia-team-preview": "0.0.1",
    "@theia/core": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/plugin-ext-vscode": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/workspace": "1.77.0"
  },
  "devDependencies": {
    "@theia/cli": "1.77.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "npm run build:parser && npm run build --workspace @near-ai/theia-team-preview && theia build && cp extension/assets/* lib/frontend/ && node tools/build-sterling-documentation.mjs",
    "start": "theia start --hostname 127.0.0.1 --port 18771",
    "build:parser": "esbuild tools/team-parser-entry.ts --bundle --platform=node --format=cjs --outfile=../../../dist/agent/teams.js"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Sterling Sovereign AI"
      }
    }
  }
}
