{
  "name": "sterling-workbench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The Sterling Sovereign AI workbench: an Eclipse Theia browser app with the Sterling pages, built into a UBI 9 image. Not the VS Code extension.",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "workspaces": [
    "extension"
  ],
  "dependencies": {
    "@near-ai/sterling-workbench-extension": "0.1.0",
    "@theia/core": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/plugin-ext-vscode": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/workspace": "1.77.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@theia/cli": "1.77.0",
    "@types/node": "26.6.6",
    "beautiful-mermaid": "1.1.3",
    "esbuild": "0.28.2",
    "markdown-it": "14.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "build": "node tools/build-engine.mjs && npm run build --workspace @near-ai/sterling-workbench-extension && theia build --mode production && cp extension/assets/* lib/frontend/ && node tools/build-sterling-documentation.mjs",
    "lint": "tsc --noEmit -p extension/tsconfig.json && tsc -p tsconfig.json",
    "test": "node scripts/build.mjs && node ../scripts/run-tests.mjs dist/test/*.test.js dist/test/staff/*.test.js",
    "test:container": "node scripts/build.mjs && node ../scripts/run-tests.mjs --test-concurrency=1 dist/test/container/*.test.js",
    "start": "node bin/start.mjs"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Sterling Sov AI",
        "preferences": {
          "telemetry.telemetryLevel": "off"
        }
      }
    }
  }
}
