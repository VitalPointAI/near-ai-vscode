{
  "chart": "keycloakx",
  "namespace": "sterling-identity",
  "order": 55,
  "values": [
    "deploy/values/keycloakx.yaml"
  ],
  "site": "deploy/values/site.example/keycloakx.yaml",
  "images": [
    {
      "lock": "quay.io/keycloak/keycloak",
      "set": {
        "image.repository": "name",
        "image.digest": "digest"
      }
    }
  ],
  "secrets": [
    {
      "secret": "keycloak-db",
      "kv": "postgres",
      "keys": {
        "password": {
          "field": "keycloak-password",
          "generate": "random-32",
          "minLength": 43
        }
      }
    },
    {
      "secret": "keycloak-admin-bootstrap",
      "kv": "keycloak-bootstrap",
      "keys": {
        "username": {
          "value": "temp-admin"
        },
        "password": {
          "generate": "random-32",
          "minLength": 43
        }
      }
    }
  ],
  "note": "The official Keycloak 26.8.2 image on chart keycloakx 7.4.0 (D-30, research Decision 10)."
}
