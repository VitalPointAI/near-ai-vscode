{
  "chart": "path:deploy/charts/sterling-postgres",
  "namespace": "sterling-identity",
  "order": 50,
  "values": [
    "deploy/values/sterling-postgres.yaml"
  ],
  "site": "deploy/values/site.example/sterling-postgres.yaml",
  "images": [
    {
      "lock": "sterling/postgres",
      "set": {
        "image": "ref"
      }
    }
  ],
  "secrets": [
    {
      "secret": "postgres-superuser",
      "kv": "postgres",
      "keys": {
        "superuser-password": {
          "generate": "random-32",
          "minLength": 43
        },
        "keycloak-password": {
          "generate": "random-32",
          "minLength": 43
        }
      }
    }
  ],
  "note": "Keycloak's Postgres, TLS only (D-18); before Keycloak."
}
