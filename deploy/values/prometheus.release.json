{
  "chart": "prometheus",
  "namespace": "sterling-monitoring",
  "order": 84,
  "values": [
    "deploy/values/prometheus.yaml",
    "deploy/values/prometheus-alerts.yaml"
  ],
  "site": "deploy/values/site.example/prometheus.yaml",
  "images": [
    {
      "lock": "quay.io/prometheus/prometheus",
      "set": {
        "server.image.repository": "name",
        "server.image.digest": "digest"
      }
    },
    {
      "lock": "quay.io/prometheus-operator/prometheus-config-reloader",
      "set": {
        "configmapReload.prometheus.image.repository": "name",
        "configmapReload.prometheus.image.digest": "digest"
      }
    },
    {
      "lock": "registry.k8s.io/kube-state-metrics/kube-state-metrics",
      "set": {
        "kube-state-metrics.image.registry": "registry",
        "kube-state-metrics.image.repository": "repository",
        "kube-state-metrics.image.sha": "digest"
      }
    },
    {
      "lock": "quay.io/prometheus/node-exporter",
      "set": {
        "prometheus-node-exporter.image.registry": "registry",
        "prometheus-node-exporter.image.repository": "repository",
        "prometheus-node-exporter.image.digest": "digest"
      }
    },
    {
      "lock": "quay.io/prometheus/alertmanager",
      "set": {
        "alertmanager.image.repository": "name",
        "alertmanager.image.tag": "tagAtDigest"
      }
    },
    {
      "lock": "quay.io/prometheus-operator/prometheus-config-reloader",
      "set": {
        "alertmanager.configmapReload.image.repository": "name",
        "alertmanager.configmapReload.image.tag": "tagAtDigest"
      }
    }
  ],
  "note": "Prometheus v3.16.0 with kube-state-metrics, node-exporter and Alertmanager v0.35.0 (research Decision 4 metrics; the alert rules are deploy/values/prometheus-alerts.yaml, 48.1-02); no pushgateway."
}
