    { "lock": "docker.io/goharbor/harbor-registryctl", "set": { "registry.controller.image.repository": "name", "registry.controller.image.tag": "tagAtDigest" } },
    { "lock": "docker.io/goharbor/harbor-db", "set": { "database.internal.image.repository": "name", "database.internal.image.tag": "tagAtDigest" } },
