{
  "realm": "sterling",
  "displayName": "Sterling",
  "loginTheme": "sterling",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "attributes": {
    "acr.loa.map": "{\"webauthn\":1,\"${site.stepUpAcr}\":2}"
  },
  "webAuthnPolicyPasswordlessRpEntityName": "Sterling",
  "webAuthnPolicyPasswordlessRpId": "${site.rpId}",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "${site.webAuthnAttestation}",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "not specified",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessCreateTimeout": 0,
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": true,
  "webAuthnPolicyPasswordlessAcceptableAaguids": "${site.acceptableAaguids}",
  "webAuthnPolicyPasswordlessExtraOrigins": [],
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "eventsEnabled": true,
  "eventsExpiration": "${site.realm.eventsExpirationSeconds}",
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "smtpServer": {
    "host": "${site.realm.smtp.host}",
    "port": "${site.realm.smtp.port}",
    "from": "${site.realm.smtp.from}",
    "starttls": "true",
    "auth": "false"
  },
  "browserFlow": "sterling-browser",
  "directGrantFlow": "sterling-no-credentials",
  "resetCredentialsFlow": "sterling-no-credentials",
  "firstBrokerLoginFlow": "sterling-no-credentials",
  "dockerAuthenticationFlow": "sterling-no-credentials",
  "requiredActions": [
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 80,
      "config": {}
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": false,
      "defaultAction": false,
      "priority": 70,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": false,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": false,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "CONFIGURE_RECOVERY_AUTHN_CODES",
      "name": "Recovery Authentication Codes",
      "providerId": "CONFIGURE_RECOVERY_AUTHN_CODES",
      "enabled": false,
      "defaultAction": false,
      "priority": 130,
      "config": {}
    },
    {
      "alias": "UPDATE_EMAIL",
      "name": "Update Email",
      "providerId": "UPDATE_EMAIL",
      "enabled": false,
      "defaultAction": false,
      "priority": 100,
      "config": {}
    }
  ],
  "authenticationFlows": [
    {
      "alias": "sterling-browser",
      "description": "Passwordless WebAuthn only (a passkey or a hardware security key, as the site's signInKeys sets), with a fresh-ceremony step-up level",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 0,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 1,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 2,
          "flowAlias": "sterling-browser webauthn",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sterling-browser webauthn",
      "description": "WebAuthn by level of authentication",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 0,
          "flowAlias": "sterling level 1",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 1,
          "flowAlias": "sterling level 2 fresh",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sterling level 1",
      "description": "Level 1 (acr webauthn): a WebAuthn passwordless ceremony",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "sterling loa 1",
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 0,
          "userSetupAllowed": false
        },
        {
          "authenticator": "webauthn-authenticator-passwordless",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 1,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sterling level 2 fresh",
      "description": "Level 2 (the step-up acr): a fresh WebAuthn passwordless ceremony, valid only for the site's step-up window",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "sterling loa 2",
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 0,
          "userSetupAllowed": false
        },
        {
          "authenticator": "webauthn-authenticator-passwordless",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 1,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sterling-no-credentials",
      "description": "Bound to direct grant, reset credentials, first broker login and docker: no credential step, so none of them can sign anyone in",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": []
    },
    {
      "alias": "sterling-hq-first-login",
      "description": "First sign-in through HQ (D-36): finds the local person with the same email and links them; never creates a person and asks for nothing",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-detect-existing-broker-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 0,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-auto-link",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 1,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sterling-x509",
      "description": "Optional smart-card sign-in (D-32), not bound by default: a PKI client certificate, then WebAuthn as the site file sets",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 0,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 1,
          "flowAlias": "sterling-x509 forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "sterling-x509 forms",
      "description": "The client certificate, then WebAuthn passwordless (REQUIRED or DISABLED as the site file sets)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "sterling x509",
          "authenticator": "auth-x509-client-username-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 0,
          "userSetupAllowed": false
        },
        {
          "authenticator": "webauthn-authenticator-passwordless",
          "authenticatorFlow": false,
          "requirement": "${site.realm.x509.webauthnRequirement}",
          "priority": 1,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "sterling loa 1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "sterling loa 2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "${site.stepUpMaxAgeSeconds}"
      }
    },
    {
      "alias": "sterling x509",
      "config": {
        "x509-cert-auth.mapping-source-selection": "Subject's e-mail",
        "x509-cert-auth.mapper-selection": "Username or Email",
        "x509-cert-auth.ocsp-checking-enabled": "${site.realm.x509.ocspCheckingEnabled}",
        "x509-cert-auth.ocsp-responder-uri": "${site.realm.x509.ocspResponderUri}",
        "x509-cert-auth.ocsp-fail-open": "false",
        "x509-cert-auth.crl-checking-enabled": "${site.realm.x509.crlCheckingEnabled}",
        "x509-cert-auth.crldp-checking-enabled": "false",
        "x509-cert-auth.crl-relative-path": "${site.realm.x509.crlPath}",
        "x509-cert-auth.confirmation-page-disallowed": "true"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"guestUntil\",\"displayName\":\"Guest until (UTC)\",\"group\":\"guest\",\"validations\":{\"pattern\":{\"pattern\":\"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$\",\"error-message\":\"The end must be a UTC time like 2026-12-31T17:00:00Z.\"}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"guestRequestedBy\",\"displayName\":\"Requested by (lead)\",\"group\":\"guest\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"guestApprovedBy\",\"displayName\":\"Approved by (security contact)\",\"group\":\"guest\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"guestApprovalRef\",\"displayName\":\"Approval reference\",\"group\":\"guest\",\"validations\":{\"length\":{\"max\":128}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"guestEndedAt\",\"displayName\":\"Ended at (UTC)\",\"group\":\"guest\",\"validations\":{\"length\":{\"max\":32}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"guestEndedReason\",\"displayName\":\"Why the account ended\",\"group\":\"guest\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"},{\"name\":\"guest\",\"displayHeader\":\"Guest account\",\"displayDescription\":\"The guest account's life cycle: its end, who asked, who approved and when it ended. Only administrators see these.\"}]}"
          ]
        }
      }
    ]
  },
  "groups": [
    {
      "name": "guests",
      "path": "/guests",
      "attributes": {},
      "realmRoles": [],
      "clientRoles": {},
      "subGroups": []
    }
  ],
  "identityProviders": [
    {
      "alias": "hq",
      "displayName": "Sign in through HQ",
      "providerId": "oidc",
      "enabled": "${site.realm.hq.enabled}",
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "sterling-hq-first-login",
      "config": {
        "issuer": "${site.realm.hq.issuer}",
        "authorizationUrl": "${site.realm.hq.issuer}/protocol/openid-connect/auth",
        "tokenUrl": "${site.realm.hq.issuer}/protocol/openid-connect/token",
        "userInfoUrl": "${site.realm.hq.issuer}/protocol/openid-connect/userinfo",
        "jwksUrl": "${site.realm.hq.issuer}/protocol/openid-connect/certs",
        "logoutUrl": "${site.realm.hq.issuer}/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "${site.realm.hq.clientId}",
        "clientSecret": "${site.realm.hq.clientSecret}",
        "clientAuthMethod": "client_secret_post",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT",
        "backchannelSupported": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "sterling-sessions",
      "name": "Sterling sessions",
      "description": "The oauth2-proxy in front of each person's session and the landing page (47-15); OpenBao's jwt roles bind its audience (47-07)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:STERLING_SESSIONS_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": "${site.realm.redirectUris}",
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "sterling-sessions audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sterling-sessions",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "acr loa level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sterling-supply-review",
      "name": "Software registry approvals",
      "description": "The sign-in of the people who approve items in your organization's software registry (48.3-05, D-18): the device grant, or the code flow with PKCE to a loopback address on the approver's own computer; always at the step-up level. OpenBao's jwt role supply-approver binds its audience",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1/*",
        "http://[::1]/*"
      ],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "pkce.code.challenge.method": "S256",
        "default.acr.values": "${site.stepUpAcr}",
        "minimum.acr.value": "${site.stepUpAcr}"
      },
      "protocolMappers": [
        {
          "name": "sterling-supply-review audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sterling-supply-review",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "acr loa level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "sterling_auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "sterling_auth_time",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
