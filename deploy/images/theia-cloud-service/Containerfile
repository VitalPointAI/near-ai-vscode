# The Theia Cloud service image, rebuilt by us from the pinned Theia Cloud source on UBI 9 (D-23, D-12). The source is the pinned
# Theia Cloud 1.2.0 commit in image.json, given to the build as the named build context upstream (deploy/images/README.md).
#   build:   ubi9/openjdk-21, the JDK and Maven stage (build scope only).
#   runtime: ubi9/openjdk-21-runtime, the image that runs at a site.
# Both are pinned to the linux/amd64 image manifest digest, the form that survives the bundle copy (spike S1, 47-01-SUMMARY.md). To re-pin, read
# the tag's index with an anonymous manifest request (or podman manifest inspect <image>:<tag>), take the linux/amd64 entry's digest, check
# that the bytes fetched by that digest hash to it, and replace the line. The same base carries the same digest in every Containerfile here.
FROM registry.access.redhat.com/ubi9/openjdk-21:1.24@sha256:678acf0a00bb4a0d986b8397f472531aa2fe8d2b068f360c96f835889cac44c3 AS build
# The upstream service build (dockerfiles/service/Dockerfile at 1.2.0) as a Quarkus uber-jar.
COPY --from=upstream --chown=185:0 java/common /home/default/build/common
RUN cd /home/default/build/common/maven-conf && mvn -B clean install --no-transfer-progress \
 && cd /home/default/build/common/org.eclipse.theia.cloud.common && mvn -B clean install --no-transfer-progress
COPY --from=upstream --chown=185:0 java/service /home/default/build/service
RUN cd /home/default/build/service/org.eclipse.theia.cloud.service \
 && mvn -B clean package -Dmaven.test.skip=true -Dquarkus.package.type=uber-jar --no-transfer-progress


FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24@sha256:7fc9128f130fe28d913ac4ad1659f764675a8382bffaf42eb8c8f8cfbd17865f
# The upstream defaults except the public sample client secret, which is not baked in: entrypoint.sh refuses to start without a real one.
USER root
RUN mkdir -p /service
COPY --from=build --chown=0:0 --chmod=0444 /home/default/build/service/org.eclipse.theia.cloud.service/target/service-1.2.0-runner.jar /service/
COPY --chown=0:0 --chmod=0555 entrypoint.sh /service/entrypoint.sh
USER 185
WORKDIR /service
ENV SERVICE_PORT=8081 KEYCLOAK_ENABLE=true KEYCLOAK_CLIENTID=theia-cloud KEYCLOAK_ADMIN_GROUP=theia-cloud/admin
ENTRYPOINT ["/service/entrypoint.sh"]
