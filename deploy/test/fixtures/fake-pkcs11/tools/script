#!/bin/sh
# Fake util-linux script(1) for deploy/test/dev-site-key.test.mjs. Records its arguments in $FAKE_LOG and takes only the call shape
# deploy/keys/new-dev-site-key.sh uses: script -q -e -c <command> <log>. It cannot give the command a terminal, so it sets FAKE_PTY=1,
# which the fake pkcs11-tool takes in place of a terminal on standard output. Like the real one, it runs the command with $SHELL, writes
# what the command prints to <log> with CR LF line ends (a terminal's), shows it on standard output and exits with the command's status.
set -eu
printf 'script' >> "$FAKE_LOG"
for arg in "$@"; do printf '|%s' "$arg" >> "$FAKE_LOG"; done
printf '\n' >> "$FAKE_LOG"

[ "$#" -eq 5 ] && [ "$1" = -q ] && [ "$2" = -e ] && [ "$3" = -c ] || { echo "fake script: unexpected arguments" >&2; exit 2; }
command=$4
log=$5
status=0
FAKE_PTY=1 "${SHELL:-/bin/sh}" -c "$command" > "$log" 2>&1 || status=$?
sed 's/$/\r/' "$log" > "$log.crlf"
mv "$log.crlf" "$log"
cat "$log"
exit "$status"
