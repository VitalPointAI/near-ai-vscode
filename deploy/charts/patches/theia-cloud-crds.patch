# The carried patch of the Theia Cloud CRDs 1.2.0 chart (D-21, research Pattern 2), applied by deploy/charts/vendor.mjs to the hash-checked
# upstream tarball (deploy/charts/vendored/theia-cloud-crds-1.2.0.tgz) to make deploy/charts/vendored/theia-cloud-crds-1.2.0-sterling.tgz.
# conversion-webhook-deployment.yaml has no security context, so Pod Security restricted (enforced in theia-cloud) refused the webhook, and
# no pull policy setting (D-20): the patch adds the restricted pod and container settings and imagePullPolicy IfNotPresent.
--- a/theia-cloud-crds/templates/conversion-webhook-deployment.yaml
+++ b/theia-cloud-crds/templates/conversion-webhook-deployment.yaml
@@ -15,9 +15,19 @@
       labels:
         app: conversion-webhook
     spec:
+      # Sterling (deploy/charts/patches): Pod Security restricted, which the theia-cloud namespace enforces.
+      securityContext:
+        runAsNonRoot: true
+        seccompProfile:
+          type: RuntimeDefault
       containers:
         - name: conversion-webhook-container
           image: {{ .Values.conversion.image }}
+          imagePullPolicy: IfNotPresent
+          securityContext:
+            allowPrivilegeEscalation: false
+            capabilities:
+              drop: [ALL]
           ports:
             - name: tls
               containerPort: 443
