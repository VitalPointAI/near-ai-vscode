    "start": "node dist/bin.mjs"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild": false
  }
}
