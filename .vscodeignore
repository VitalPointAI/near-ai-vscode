.git/**
.gitignore
.vscode-test/**
docs/*.pdf
# Reference solutions only check the benchmark's graders (evalExecution.test.ts); Compare Models never needs them.
resources/benchmark/**/reference/**
# The export downloads the verified Treasury Board privacy forms on demand. The repository copies serve as test fixtures.
resources/saa/official/*.docx

# Live model-eval results (NEAR_LIVE_EVAL_OUT)
eval-*.json

# Repository workflow files (CI, PR template, contributor docs)
.github/**
# The Sterling Theia workbench is its own package with its own lockfile and never ships in the extension (Phase 46, D-10).
workbench/**
CONTRIBUTING.md
docs/development-workflow.md
# The messaging relay is its own service with its own lockfile and never ships in the extension.
relay/**
# Your organization's sync hub is its own service with its own lockfile and never ships in the extension (D-33).
hub/**
.dockerignore
# The documentation site is its own workspace with its own lockfile and never ships in the extension.
docs-site/**
docs/testing.md
# The compliance package and the security documents are their own package and documents and never ship in the extension (D-48).
compliance/**
# The load-test harness (Phase 48) and the on-premise deployment stack (Phase 47) are their own packages and never ship in the extension.
loadtest/**
deploy/**
docs/security/**
