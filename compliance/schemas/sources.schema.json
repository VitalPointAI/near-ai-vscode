{
  "$id": "urn:near-ai-vscode:compliance:schema:sources",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "licence", "licenceEvidence", "use", "pages"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "licence": { "type": "string" },
          "licenceEvidence": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "recordId"],
                "properties": {
                  "kind": { "const": "ckan" },
                  "recordId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "url"],
                "properties": {
                  "kind": { "const": "page" },
                  "url": { "type": "string", "format": "uri" }
                }
              }
            ]
          },
          "use": { "enum": ["text", "ids-and-links", "cite", "cross-check"] },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "licenceCheckedAt": { "type": "string", "format": "date-time" },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url"],
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "lang": { "enum": ["en", "fr"] },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "bytes": { "type": "integer", "minimum": 0 },
                "dateModified": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
