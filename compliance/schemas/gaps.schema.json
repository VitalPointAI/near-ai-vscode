{
  "$id": "urn:near-ai-vscode:compliance:schema:gaps",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["gaps"],
  "properties": { "gaps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/gap" } } },
  "definitions": {
    "control": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "controls", "remediation", "ownerRole"],
      "oneOf": [{ "properties": { "closesInPhase": { "type": "string" } }, "required": ["closesInPhase"] }, { "properties": { "poam": { "type": "string" } }, "required": ["poam"] }],
      "properties": {
        "id": { "type": "string", "pattern": "^[GX][0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "controls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/control" } },
        "remediation": { "type": "string", "minLength": 1 },
        "ownerRole": { "type": "string", "enum": ["maintainers", "release-owner", "owner", "shared"] },
        "overlay": { "type": "string", "enum": ["both"] },
        "closesInPhase": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "poam": { "type": "string", "pattern": "^[gx][0-9]{2,}$" }
      }
    }
  }
}
