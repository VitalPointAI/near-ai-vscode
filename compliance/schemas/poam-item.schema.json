{
  "$id": "urn:near-ai-vscode:compliance:schema:poam-item",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["id", "gap", "title", "controls", "remediation", "ownerRole", "milestones"],
  "properties": {
    "id": { "type": "string", "pattern": "^[gx][0-9]{2,}$" },
    "gap": { "type": "string", "pattern": "^[GX][0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "controls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" } },
    "remediation": { "type": "string", "minLength": 1 },
    "ownerRole": { "type": "string", "enum": ["maintainers", "release-owner", "owner", "shared"] },
    "milestones": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/milestone" } }
  },
  "definitions": {
    "milestone": { "type": "object", "additionalProperties": false, "required": ["title"], "anyOf": [{ "properties": { "phase": { "type": "string" } }, "required": ["phase"] }, { "properties": { "targetDate": { "type": "string" } }, "required": ["targetDate"] }], "properties": { "title": { "type": "string", "minLength": 1 }, "phase": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" }, "targetDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } }
  }
}
