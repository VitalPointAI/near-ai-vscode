{
  "$id": "urn:near-ai-vscode:compliance:schema:exchanges",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The exchange and interconnection register of the hosted deployment (48.1-01, D-10): compliance/hosted/exchanges.json. Rendered into docs/security/hosted-interconnections.md by `node compliance/src/cli.ts hosted-docs --write`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "exchanges"],
  "properties": {
    "note": { "type": "string", "minLength": 1 },
    "exchanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/exchange" } }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "from", "to", "direction", "data", "format", "protection", "frequency", "status", "siteSettings", "controls", "agreement", "operatorJurisdiction", "location"],
      "oneOf": [
        { "properties": { "status": { "type": "string", "const": "implemented" }, "implementedBy": { "type": "array", "minItems": 1 } }, "required": ["implementedBy"] },
        { "properties": { "status": { "type": "string", "const": "planned" }, "plannedIn": { "type": "string" } }, "required": ["plannedIn"] }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,47}$" },
        "title": { "$ref": "#/definitions/text" },
        "kind": { "type": "string", "enum": ["file", "network"] },
        "from": { "$ref": "#/definitions/text" },
        "to": { "$ref": "#/definitions/text" },
        "direction": { "type": "string", "enum": ["one-way", "both-ways"] },
        "data": { "$ref": "#/definitions/text" },
        "format": { "$ref": "#/definitions/text" },
        "protection": { "$ref": "#/definitions/text" },
        "frequency": { "$ref": "#/definitions/text" },
        "status": { "type": "string", "enum": ["implemented", "planned"] },
        "implementedBy": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
        "plannedIn": { "type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?-[0-9]{2}|Phase [0-9]+(?:\\.[0-9]+)?)$" },
        "siteSettings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^site\\.example(?:\\.yaml|/[a-z0-9-]+\\.yaml)#[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$" } },
        "controls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" } },
        "agreement": { "$ref": "#/definitions/text" },
        "operatorJurisdiction": { "type": "string", "pattern": "^([A-Z]{2}|org|unknown)$", "description": "48.4 D-08: ISO 3166-1 alpha-2 code of the legal seat of the far end's operator, org when your organization operates it, or unknown." },
        "location": { "type": "string", "pattern": "^([A-Z]{2}|site|unknown)$", "description": "48.4 D-08: where the far end is: an ISO 3166-1 alpha-2 code, site when inside the site, or unknown." }
      }
    }
  }
}
