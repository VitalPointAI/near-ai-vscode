{
  "$id": "urn:near-ai-vscode:compliance:schema:tailoring",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "notApplicable", "parameters", "removals"],
  "properties": {
    "level": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "notApplicable": { "type": "array", "items": { "$ref": "#/definitions/notApplicable" } },
    "removals": { "type": "array", "items": { "$ref": "#/definitions/review" } },
    "parameters": { "type": "array", "items": { "$ref": "#/definitions/parameter" } }
  },
  "definitions": {
    "review": { "type": "object", "additionalProperties": false, "required": ["control", "reason", "reviewer", "reviewedAt"], "properties": { "control": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" }, "reason": { "type": "string", "minLength": 1 }, "reviewer": { "type": "string", "minLength": 1 }, "reviewedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } },
    "notApplicable": { "type": "object", "additionalProperties": false, "required": ["control", "component", "reason", "reviewer", "reviewedAt"], "properties": { "control": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" }, "component": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }, "reason": { "type": "string", "minLength": 1 }, "reviewer": { "type": "string", "minLength": 1 }, "reviewedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } },
    "parameter": { "type": "object", "additionalProperties": false, "required": ["control", "param", "value", "reason"], "properties": { "control": { "type": "string" }, "param": { "type": "string", "minLength": 1 }, "value": {}, "reason": { "type": "string", "minLength": 1 } } }
  }
}
