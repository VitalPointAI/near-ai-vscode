{
  "$id": "urn:near-ai-vscode:compliance:schema:risk-acceptance",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "controlId": {
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
      "type": "string"
    },
    "isoTime": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "levelId": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "text": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "type": "string"
    }
  },
  "description": "A risk acceptance (D-20): the extension's signed-payload envelope with the purpose for compliance risk acceptances. A named person accepts the risk of one gap's controls until a date at most 365 days after it was issued. It is shown as risk accepted until that date, never as met.",
  "properties": {
    "payload": {
      "additionalProperties": false,
      "properties": {
        "controls": {
          "items": {
            "$ref": "#/definitions/controlId"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "expiresAt": {
          "$ref": "#/definitions/isoTime"
        },
        "gap": {
          "pattern": "^[GX][0-9]{1,2}$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "issuedAt": {
          "$ref": "#/definitions/isoTime"
        },
        "levels": {
          "items": {
            "$ref": "#/definitions/levelId"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "namedPerson": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/definitions/text"
            },
            "role": {
              "$ref": "#/definitions/text"
            }
          },
          "required": [
            "name",
            "role"
          ],
          "type": "object"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "^\\S[\\s\\S]*\\S$",
          "type": "string"
        },
        "v": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "controls",
        "expiresAt",
        "gap",
        "id",
        "issuedAt",
        "namedPerson",
        "reason",
        "v"
      ],
      "type": "object"
    },
    "purpose": {
      "const": "compliance-risk-acceptance",
      "type": "string"
    },
    "sig": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "type": "string"
    },
    "signedAt": {
      "$ref": "#/definitions/isoTime"
    },
    "signer": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "pattern": "^dev-[0-9a-f]{32}$",
          "type": "string"
        },
        "publicKey": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "publicKey"
      ],
      "type": "object"
    },
    "v": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "payload",
    "purpose",
    "sig",
    "signedAt",
    "signer",
    "v"
  ],
  "title": "Risk acceptance",
  "type": "object"
}
