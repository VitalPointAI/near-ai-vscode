{
  "$id": "urn:near-ai-vscode:compliance:schema:signers",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Who may sign a risk acceptance (D-20). Each entry is a named person, their role and their Ed25519 public key with its fingerprint. Only the owner adds an entry; the file is a gate path.",
  "properties": {
    "signers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "pattern": "^dev-[0-9a-f]{32}$",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$",
            "type": "string"
          },
          "publicKey": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "type": "string"
          },
          "role": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$",
            "type": "string"
          }
        },
        "required": [
          "fingerprint",
          "name",
          "publicKey",
          "role"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    }
  },
  "required": [
    "signers"
  ],
  "title": "Risk acceptance signers",
  "type": "object"
}
