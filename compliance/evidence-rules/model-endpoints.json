{
  "rules": [
    { "id": "model-endpoints.sc-08.connection-binding", "component": "model-endpoints", "control": "sc-08", "statement": "sc-08_smt.endpoint-binding", "kind": "test", "test": { "file": "src/test/gateConnectionBinding.test.ts", "path": [], "name": "at Confidential a mismatch on the pinned connection still refuses: nothing goes over the normal fetch and nothing falls back" } },
    { "id": "model-endpoints.sc-13.listed", "component": "model-endpoints", "control": "sc-13", "statement": "sc-13_smt.listed", "kind": "observation", "observation": { "collector": "crypto", "subject": "aes-256-gcm" } },
    { "id": "model-endpoints.sc-13.x25519", "component": "model-endpoints", "control": "sc-13", "statement": "sc-13_smt.x25519-scrypt", "kind": "observation", "observation": { "collector": "crypto", "subject": "x25519" } },
    { "id": "model-endpoints.sc-13.scrypt", "component": "model-endpoints", "control": "sc-13", "statement": "sc-13_smt.x25519-scrypt", "kind": "observation", "observation": { "collector": "crypto", "subject": "scrypt" } },
    {"id": "model-endpoints.sa-04.licences-at-publisher", "component": "model-endpoints", "control": "sa-04", "statement": "sa-04_smt.model-licences", "kind": "test", "test": {"file": "src/test/gatePassports.test.ts", "path": [], "name": "74.1-01: Nemotron 3 Nano and Super name the NVIDIA Nemotron Open Model License; Ultra names OpenMDW-1.1"}},
    {"id": "model-endpoints.sa-04.command-a-plus-vault", "component": "model-endpoints", "control": "sa-04", "statement": "sa-04_smt.model-licences", "kind": "test", "test": {"file": "src/test/gatePassports.test.ts", "path": [], "name": "74.1-01: the shipped Command A+ row covers the Model Vault classes and never NEAR AI's private hardware or your organization's own hosting"}},
    {"id": "model-endpoints.sa-04.licence-change", "component": "model-endpoints", "control": "sa-04", "statement": "sa-04_smt.model-licences", "kind": "test", "test": {"file": "src/test/gatePassportState.test.ts", "path": [], "name": "licence-change: a reported licence other than the passport's"}},
    {"id": "model-endpoints.sa-09.hosting-mismatch", "component": "model-endpoints", "control": "sa-09", "statement": "sa-09_smt.model-places", "kind": "test", "test": {"file": "src/test/gatePassports.test.ts", "path": [], "name": "passportCovers: a T2 passport covers T2 on a class it lists; T3 exceeds it; an unlisted class is a hosting mismatch"}},
    {"id": "model-endpoints.sa-09.hosting-change", "component": "model-endpoints", "control": "sa-09", "statement": "sa-09_smt.model-places", "kind": "test", "test": {"file": "src/test/gatePassportTriggers.test.ts", "path": [], "name": "D-15: through routeFactsFor, a change of place fires hosting-change once: one route.passport-triggered record, kept in the facts"}},
    {"id": "model-endpoints.sa-09.organization-copy", "component": "model-endpoints", "control": "sa-09", "statement": "sa-09_smt.model-places", "kind": "test", "test": {"file": "src/test/gatePassports.test.ts", "path": [], "name": "74.1-01: your organization's Command A+ passport with its artifact hash replaces the shipped row and covers T2 on org-tee; without the hash it is refused"}},
    {"id": "model-endpoints.cm-10.non-commercial", "component": "model-endpoints", "control": "cm-10", "statement": "cm-10_smt.licence-use", "kind": "test", "test": {"file": "src/test/gatePassportRefusals.test.ts", "path": [], "name": "D-06: a passport under a non-commercial licence is research only off a vendor class; on a vendor class the vendor's terms apply"}},
    {"id": "model-endpoints.cm-10.licence-refusal", "component": "model-endpoints", "control": "cm-10", "statement": "cm-10_smt.licence-use", "kind": "test", "test": {"file": "src/test/gatePassportRefusals.test.ts", "path": [], "name": "licence: the refusal names the licence and points to the vendor's own service"}},
    {"id": "model-endpoints.sr-03.prc-refused", "component": "model-endpoints", "control": "sr-03", "statement": "sr-03_smt.model-origin", "kind": "test", "test": {"file": "src/test/gatePassportEnforce.test.ts", "path": [], "name": "tracer: under enforce, agent work for a PRC-origin model is refused before anything is sent, with route.passport and the gap's sentence"}},
    {"id": "model-endpoints.sr-03.prc-research-only", "component": "model-endpoints", "control": "sr-03", "statement": "sr-03_smt.model-origin", "kind": "test", "test": {"file": "src/test/gatePassports.test.ts", "path": [], "name": "no shipped passport claims T3 or carries an evaluation; every PRC-origin row is T0; each lives at most 365 days"}},
    {"id": "model-endpoints.sr-03.no-self-signed-exception", "component": "model-endpoints", "control": "sr-03", "statement": "sr-03_smt.model-origin", "kind": "test", "test": {"file": "src/test/gatePassportRefusals.test.ts", "path": [], "name": "D-20: the same authorization verified only against this device's key (self-signed, no organization layer) covers nothing"}},
    {"id": "model-endpoints.sr-03.lane-no-tools", "component": "model-endpoints", "control": "sr-03", "statement": "sr-03_smt.model-origin", "kind": "test", "test": {"file": "src/test/researchLane.test.ts", "path": [], "name": "D-17: the lane offers no tool at all, whatever its name"}},
    {"id": "model-endpoints.sr-03.lane-no-project-files", "component": "model-endpoints", "control": "sr-03", "statement": "sr-03_smt.model-origin", "kind": "test", "test": {"file": "src/test/researchLane.test.ts", "path": [], "name": "D-17: a project file, or any file outside the lane folder, may not be attached directly"}},
    {"id": "model-endpoints.sr-04.teachers", "component": "model-endpoints", "control": "sr-04", "statement": "sr-04_smt.model-provenance", "kind": "test", "test": {"file": "src/test/gatePassports.test.ts", "path": [], "name": "74.1-01: every Nemotron 3 row lists gpt-oss-120b (US) beside its PRC teachers"}},
    {"id": "model-endpoints.sr-04.request-record", "component": "model-endpoints", "control": "sr-04", "statement": "sr-04_smt.model-provenance", "kind": "test", "test": {"file": "src/test/gatePassportEnforce.test.ts", "path": [], "name": "D-23: the refused PRC request writes one record with route.passport, the use, the passport by id and hash, and the gap"}},
    {"id": "model-endpoints.sr-04.ai-bom-pedigree", "component": "model-endpoints", "control": "sr-04", "statement": "sr-04_smt.model-provenance", "kind": "test", "test": {"file": "src/test/aiBom.test.ts", "path": [], "name": "D-24: a Nemotron 3 component lists its base and each teacher as pedigree ancestors with origin"}},
    {"id": "model-endpoints.sr-04.ai-bom-export", "component": "model-endpoints", "control": "sr-04", "statement": "sr-04_smt.model-provenance", "kind": "test", "test": {"file": "src/test/aiBomExportHost.test.ts", "path": [], "name": "D-24: the export writes .near-ai/state/ai-bom.cdx.json from the project's log and says where; a second run gives the same bytes"}},
    {"id": "model-endpoints.sa-11.not-evaluated", "component": "model-endpoints", "control": "sa-11", "statement": "sa-11_smt.evaluation-before-role", "kind": "test", "test": {"file": "src/test/gatePassportState.test.ts", "path": [], "name": "D-16, C-4: under enforce a shipped passport (no evaluation) refuses every use above research with not-evaluated, checking included; research needs none"}},
    {"id": "model-endpoints.sa-11.evaluated", "component": "model-endpoints", "control": "sa-11", "statement": "sa-11_smt.evaluation-before-role", "kind": "test", "test": {"file": "src/test/gatePassportState.test.ts", "path": [], "name": "D-16: with your organization's evaluation and a tier that covers the use, the same requests go; a use above the approval is still tier-exceeded"}},
    {"id": "model-endpoints.sa-11.checker-evaluated", "component": "model-endpoints", "control": "sa-11", "statement": "sa-11_smt.evaluation-before-role", "kind": "test", "test": {"file": "src/test/agentCheckerRoles.test.ts", "path": [], "name": "under enforce a checker without your organization's evaluation is not started; an evaluated one is chosen"}},
    {"id": "model-endpoints.sa-11.other-family", "component": "model-endpoints", "control": "sa-11", "statement": "sa-11_smt.other-family-checks", "kind": "test", "test": {"file": "src/test/gateLineage.test.ts", "path": [], "name": "no role ever gets a model of the author's family, whatever the preference"}},
    {"id": "model-endpoints.sa-11.check-families-recorded", "component": "model-endpoints", "control": "sa-11", "statement": "sa-11_smt.other-family-checks", "kind": "test", "test": {"file": "src/test/agentCheckerRoles.test.ts", "path": [], "name": "a checker's route carries checkingJob and both families, and its records name them"}},
    {"id": "model-endpoints.cm-08.register-missing", "component": "model-endpoints", "control": "cm-08", "statement": "cm-08_smt.model-inventory", "kind": "test", "test": {"file": "scripts/test/resource-check.test.mjs", "path": [], "name": "a shipped passport with no register entry fails, and a model entry nothing discovers is stale"}},
    {"id": "model-endpoints.cm-08.ai-bom-components", "component": "model-endpoints", "control": "cm-08", "statement": "cm-08_smt.model-inventory", "kind": "test", "test": {"file": "src/test/aiBom.test.ts", "path": [], "name": "D-24: one machine-learning-model component per model used, sorted, in a CycloneDX 1.6 document"}}
  ]
