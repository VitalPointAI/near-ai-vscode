# Allow-list for the relay and hub images, built from the repository root: everything is left out unless a line below lets it in.
# relay/state, relay/secrets, hub/state, hub/secrets, hub/test, .git and .planning never enter the build context.
# The !src/ lines are the extension's hub-side closure the hub bundles (D-27, D-33), one file per line, sorted. Do not edit them by hand:
# hub/test/dockerContext.test.ts fails until they equal hubSideClosure (hub/test/helpers/closure.ts) on the tree.
# Phase 71 adds !src/agent and what it imports for the relay.
*
!relay/package.json
!relay/package-lock.json
!relay/.npmrc
!relay/tsconfig.json
!relay/scripts
!relay/src
!hub/package.json
!hub/package-lock.json
!hub/.npmrc
!hub/tsconfig.json
!hub/scripts
!hub/src
!src/domain/redaction.ts
!src/domain/replica/causal.ts
!src/domain/replica/cellKeys.ts
!src/domain/replica/cellWrapV2.ts
!src/domain/replica/chain.ts
