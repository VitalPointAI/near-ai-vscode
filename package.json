{
  "name": "near-ai-vscode",
  "displayName": "NEAR AI for VS Code",
  "description": "Private AI coding in VS Code: chat with TEE-backed NEAR AI models, run Open-GSD project workflows, and see the cost of every answer.",
  "version": "0.3.1",
  "publisher": "VitalPoint",
  "icon": "media/near-ai-vscode-icon-128.png",
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "license": "MIT",
  "homepage": "https://github.com/VitalPointAI/near-ai-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/VitalPointAI/near-ai-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/VitalPointAI/near-ai-vscode/issues"
  },
  "engines": {
    "vscode": ">=1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "chat",
    "private ai",
    "confidential computing",
    "tee",
    "near",
    "near ai",
    "open source models",
    "deepseek",
    "qwen",
    "llama",
    "coding assistant",
    "agents",
    "open-gsd",
    "project planning",
    "cost tracking"
  ],
  "activationEvents": [
    "workspaceContains:.planning/.near-ai/**"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nearAi.newChat",
        "title": "New Chat",
        "category": "NEAR AI",
        "icon": "$(add)"
      },
      {
        "command": "nearAi.showHistory",
        "title": "Show Chat History",
        "category": "NEAR AI",
        "icon": "$(history)"
      },
      {
        "command": "nearAi.openTools",
        "title": "Open Tools",
        "category": "NEAR AI",
        "icon": "$(tools)"
      },
      {
        "command": "nearAi.setup",
        "title": "Set Up",
        "category": "NEAR AI",
        "icon": "$(gear)"
      },
      {
        "command": "nearAi.selectProfile",
        "title": "Select Profile",
        "category": "NEAR AI",
        "icon": "$(account)"
      },
      {
        "command": "nearAi.status",
        "title": "Show Status",
        "category": "NEAR AI"
      },
      {
        "command": "nearAi.openChat",
        "title": "Open Chat",
        "category": "NEAR AI"
      },
      {
        "command": "nearAi.gsdCommand",
        "title": "Run Open-GSD Command…",
        "category": "NEAR AI"
      },
      {
        "command": "nearAi.gsdProgress",
        "title": "Show Open-GSD Progress",
        "category": "NEAR AI"
      },
      {
        "command": "nearAi.saveCheckpoint",
        "title": "Save Continuity Checkpoint",
        "category": "NEAR AI"
      },
      {
        "command": "nearAi.removeProfile",
        "title": "Remove Profile…",
        "category": "NEAR AI"
      },
      {
        "command": "nearAi.emergencyStop",
        "title": "Emergency Stop",
        "category": "NEAR AI",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nearAi.resume",
        "title": "Resume After Emergency Stop",
        "category": "NEAR AI"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "nearAiSecondaryViewContainer",
          "title": "NEAR AI",
          "icon": "media/near-ai-vscode-icon.svg"
        }
      ]
    },
    "views": {
      "nearAiSecondaryViewContainer": [
        {
          "type": "webview",
          "id": "nearAiChatView",
          "name": "Chat",
          "visibility": "visible"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "nearAi",
        "name": "nearai",
        "fullName": "NEAR AI",
        "description": "Chat with private NEAR AI models and run Open-GSD workflows.",
        "isSticky": true,
        "commands": [
          {
            "name": "new-project",
            "description": "Create project context and requirements from an idea."
          },
          {
            "name": "onboard",
            "description": "Map an existing repository and establish GSD context."
          },
          {
            "name": "next",
            "description": "Inspect project state and choose the appropriate next action."
          },
          {
            "name": "progress",
            "description": "Review phases, plans, current state, and recommended action."
          },
          {
            "name": "discuss-phase",
            "description": "Clarify phase intent and capture decisions before planning."
          },
          {
            "name": "plan-phase",
            "description": "Create an executable phase plan with verification steps."
          },
          {
            "name": "execute-phase",
            "description": "Run phase plans with dependency-aware agent execution."
          },
          {
            "name": "verify-work",
            "description": "Validate the implementation conversationally against acceptance criteria."
          },
          {
            "name": "code-review",
            "description": "Check changed source for bugs, security, and maintainability."
          },
          {
            "name": "audit-uat",
            "description": "Find unresolved verification and acceptance gaps."
          },
          {
            "name": "map-codebase",
            "description": "Generate architecture and codebase intelligence for agents."
          },
          {
            "name": "graphify",
            "description": "Create or inspect the planning knowledge graph."
          },
          {
            "name": "thread",
            "description": "Preserve decisions and continuity across sessions."
          },
          {
            "name": "stats",
            "description": "Display phases, plans, requirements, and project metrics."
          },
          {
            "name": "settings",
            "description": "Adjust workflow toggles, model profile, and automation."
          },
          {
            "name": "update",
            "description": "Update the installed GSD runtime and inspect its changelog."
          }
        ]
      }
    ],
    "configuration": {
      "title": "NEAR AI",
      "properties": {
        "nearAi.baseUrl": {
          "type": "string",
          "default": "https://cloud-api.near.ai/v1",
          "description": "NEAR AI Cloud API base URL."
        },
        "nearAi.defaultModel": {
          "type": "string",
          "default": "z-ai/glm-5.3",
          "description": "Model used for new chats. If NEAR AI doesn't offer it, the first available chat model is used."
        },
        "nearAi.actionPolicy": {
          "type": "string",
          "enum": [
            "approve-risky",
            "mostly-autonomous",
            "fully-autonomous"
          ],
          "default": "approve-risky",
          "description": "Default policy for agent actions.",
          "enumDescriptions": [
            "Reads and planning run automatically; file writes, shell commands, network and git changes ask first.",
            "Same approvals as approve-risky until the native runner ships its finer-grained rules.",
            "Agents act without asking. Use only in throwaway workspaces."
          ]
        },
        "nearAi.autoInstallGsd": {
          "type": "boolean",
          "default": true,
          "description": "In projects set up with NEAR AI, install Open-GSD if it is missing when you run a GSD command, and keep it on the latest stable release. Other workspaces are never touched."
        },
        "nearAi.privacyMode": {
          "type": "string",
          "enum": [
            "standard",
            "tee-only"
          ],
          "enumDescriptions": [
            "Any NEAR AI model can be used; each is labelled private or forwarded.",
            "Only models NEAR runs in an attested TEE can be used; messages to forwarded models are blocked."
          ],
          "default": "standard",
          "description": "Whether chats may use models that NEAR AI forwards to other providers."
        },
        "nearAi.dailySpendLimitUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Stop sending NEAR AI requests once today's recorded spend reaches this amount in USD. 0 means no limit."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "nearAi.newChat",
          "when": "view == nearAiChatView",
          "group": "navigation@1"
        },
        {
          "command": "nearAi.showHistory",
          "when": "view == nearAiChatView",
          "group": "navigation@2"
        },
        {
          "command": "nearAi.openTools",
          "when": "view == nearAiChatView",
          "group": "navigation@3"
        },
        {
          "command": "nearAi.setup",
          "when": "view == nearAiChatView",
          "group": "navigation@4"
        },
        {
          "command": "nearAi.selectProfile",
          "when": "view == nearAiChatView",
          "group": "overflow@0"
        },
        {
          "command": "nearAi.status",
          "when": "view == nearAiChatView",
          "group": "overflow@1"
        },
        {
          "command": "nearAi.saveCheckpoint",
          "when": "view == nearAiChatView",
          "group": "overflow@2"
        },
        {
          "command": "nearAi.removeProfile",
          "when": "view == nearAiChatView",
          "group": "overflow@0"
        },
        {
          "command": "nearAi.emergencyStop",
          "when": "view == nearAiChatView",
          "group": "overflow@9"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "generate:icon": "node scripts/generate-near-ai-icon.mjs",
    "install:global": "node scripts/install-global-extension.mjs",
    "verify:release": "npm run package && node scripts/verify-release-content.mjs",
    "check": "npm run lint && npm test",
    "generate:screenshots": "npm run compile && node scripts/generate-marketplace-screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.7.2"
  }
}
