node_modules/
dist/
*.vsix
.env
.env.*
.vscode-test/

# NEAR AI per-project runtime state (profiles metadata, activity, audit)
.planning/.near-ai/
.planning/HANDOFF.json
vendor/
sbom.cdx.json
.codex/
.agents/

# Live model-eval results (NEAR_LIVE_EVAL_OUT)
eval-*.json
.planning/research/.cache/

# Agent worktrees and local Claude Code settings
.claude/worktrees/
.claude/settings.local.json

# 0.4.18: files attached to a message and copied into the project for the agent to read.
.near-ai/attachments/
# A run's own scratch work (src/domain/scratch.ts): written and cleaned by the run, never committed.
.near-ai/scratch/
# 0.4.23: generated images waiting for review (src/agent/imageDrafts.ts), never committed.
.near-ai/drafts/

# Messaging relay (relay/): runtime state and secret files, never committed
relay/state/
relay/secrets/
relay/**/*.db
relay/**/*.db-wal
relay/**/*.db-shm

# The COP map page's vendored libraries are committed (media/vendor/VENDORED.json lists them with their hashes).
!media/vendor/
